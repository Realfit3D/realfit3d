+"""CPU connected-component labels for edge-list graphs on Pascal hosts."""
+import numpy as np
+from scipy.sparse import coo_matrix
+from scipy.sparse.csgraph import connected_components
+
+
+def edge_components(edges):
+    """Return (vertex ID, component ID) pairs for vertices present in edges."""
+    edges = np.asarray(edges, dtype=np.int64)
+    if edges.ndim != 2 or edges.shape[1] != 2:
+        raise ValueError('Expected an N x 2 integer edge array')
+    if not len(edges):
+        return np.empty((0, 2), dtype=np.int64)
+    vertices, inverse = np.unique(edges, return_inverse=True)
+    remapped = inverse.reshape(-1, 2)
+    graph = coo_matrix((np.ones(len(edges), dtype=np.uint8),
+                        (remapped[:, 0], remapped[:, 1])),
+                       shape=(len(vertices), len(vertices))).tocsr()
+    _, labels = connected_components(graph, directed=False)
+    return np.column_stack((vertices, labels)).astype(np.int64)
